# --- STAGE 1: BASE (runtime + PHP extensions) ---
FROM php:8.4-fpm-alpine AS base
WORKDIR /var/www/html

# Compilers and -dev headers are only needed to build the extensions,
# so they are removed again in the same layer
RUN apk add --no-cache \
    nginx \
    supervisor \
    icu-libs \
    libpq \
    libzip \
    libpng \
    libjpeg-turbo \
    libwebp \
    && apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    icu-dev \
    postgresql-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) \
    bcmath \
    gd \
    intl \
    opcache \
    pdo_pgsql \
    zip \
    && apk del .build-deps

# --- STAGE 2: VENDOR (composer never reaches the final image) ---
FROM base AS vendor
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Dependencies first so this layer is cached until composer.lock changes
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

COPY . .
RUN composer dump-autoload --no-dev --optimize

# --- STAGE 3: RUNNER ---
FROM base AS runner

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf
COPY default.conf /etc/nginx/http.d/default.conf

# Copy supervisor configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
# Copy PHP configuration
COPY php.ini /usr/local/etc/php/conf.d/99-custom.ini

# Application code with production dependencies
COPY --from=vendor /var/www/html ./

# php-fpm runs as www-data and must be able to write logs, cache and compiled views
RUN chown -R www-data:www-data storage bootstrap/cache \
    && mkdir -p /var/log/supervisor /var/run/nginx

# Expose port
EXPOSE 8000

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
