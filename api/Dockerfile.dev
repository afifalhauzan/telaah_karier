FROM php:8.4-cli-alpine

WORKDIR /var/www/html

# GD cuts the scam poster out of fact-checkers' article headers (App\Support\MafindoHeader)
RUN apk add --no-cache git unzip postgresql-dev libpng-dev libjpeg-turbo-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install pdo_pgsql gd

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# artisan serve is CLI PHP, where OPcache is off by default; timestamps are still checked, so edits show up
RUN echo "opcache.enable_cli=1" > /usr/local/etc/php/conf.d/opcache-cli.ini
# Same upload limits as production (api/php.ini): chat attachments are up to 4 x 7 MB per message
RUN printf "upload_max_filesize=64M\npost_max_size=64M\n" > /usr/local/etc/php/conf.d/uploads.ini

EXPOSE 8000

# Source is bind-mounted, so dependencies and migrations are handled at start.
# --no-reload is what lets PHP_CLI_SERVER_WORKERS take effect; restart the container after editing .env
CMD ["sh", "-c", "composer install --no-interaction && php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=8000 --no-reload"]
