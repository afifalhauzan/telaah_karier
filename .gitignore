*.py[cod]
*$py.class
*.log

# Database lokal
*.sqlite3
*.db

# Virtual Environment (Sesuai folder metabot di repo lu)
metabot/
.venv/
venv/
env/

# =========================
# ⚛️ FRONTEND (Next.js / Node / PNPM)
# =========================
node_modules/
# pnpm's store, when an install inside the dev container puts it in the bind-mounted project
.pnpm-store/
.next/
out/
build/
.vercel/
next-env.d.ts
*.tsbuildinfo
next.config.js

# Pnp & Logs
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests
playwright-report/
test-results/

